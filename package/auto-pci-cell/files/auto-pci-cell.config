config settings 'main'
	option enabled '0'
	option main_list '1'
	option at_port_mode 'auto'
	option manual_at_port '/dev/ttyUSB2'
	option off_action 'restore'
	option interval '5'
	option lost_secs '10'
	option min_rsrp '-125'
	option verify_timeout '20'
	option retry_delay '60'
	option neighbour_interval '30'
	option probe '1'
	option probe_interval '300'
	option probe_timeout '12'
	option call_grace '5'
	option sms_hold '20'

config cell
	option enabled '1'
	option pci '175'
	option earfcn '400'

config cell
	option enabled '1'
	option pci '175'
	option earfcn '525'

config cell
	option enabled '1'
	option pci '115'
	option earfcn '1725'
