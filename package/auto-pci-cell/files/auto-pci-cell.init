#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/auto-pci-cell
	procd_set_param file /etc/config/auto-pci-cell
	procd_set_param respawn 3600 10 0
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger auto-pci-cell
}
