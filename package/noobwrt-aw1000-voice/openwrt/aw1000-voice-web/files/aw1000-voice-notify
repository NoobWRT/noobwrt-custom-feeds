#
# Push alerts for phone call events. fxsd runs /etc/fxs/hook.sh with
# "<event> <number>"; the hook installed by aw1000-voice-web calls this.
#
#   aw1000-voice-notify <event> <number>   send if the event is enabled
#   aw1000-voice-notify test               send a test message, print result
#
# Settings: aw1000_voice.notify (Alerts page). The number comes from the
# network, so it is only ever passed as data, never evaluated.

CFG=aw1000_voice.notify
ERR=/var/run/aw1000-voice-notify.err

event="$1"
number="$2"

[ "$event" = test ] || [ "$(uci -q get $CFG.enabled)" = 1 ] || exit 0

if [ "$event" != test ]; then
	case " $(uci -q get $CFG.events) " in
	*" $event "*) ;;
	*) exit 0 ;;
	esac
fi

# Name from the phonebook, speed dial or blocked lists (last 9 digits match).
name_of() {
	local d s n

	d=$(printf '%s' "$1" | tr -cd '0-9' | tail -c 9)
	[ -n "$d" ] || return 0
	for s in $(uci -q show fxs | sed -n "s/^fxs\.\([^.=]*\)=\(contact\|speed\|block\)$/\1/p"); do
		n=$(uci -q get "fxs.$s.number" | tr -cd '0-9' | tail -c 9)
		[ "$n" = "$d" ] || continue
		uci -q get "fxs.$s.name"
		return 0
	done
}

who=${number:-a hidden number}
name=$(name_of "$number")
[ -n "$name" ] && who="$name ($number)"
host=$(uci -q get system.@system[0].hostname)

case "$event" in
test) title="Phone alerts work"; text="Test message from the phone on ${host:-the router}." ;;
missed) title="Missed call"; text="Missed call from $who." ;;
blocked) title="Blocked call"; text="Blocked a call from $who." ;;
incoming) title="Incoming call"; text="Call from $who." ;;
elsewhere) title="Answered on SIP"; text="Call from $who was answered on a SIP phone." ;;
recorded) title="Call recorded"; text="A call was recorded ($number)." ;;
*) title="Phone"; text="$event $who" ;;
esac

# JSON string escape for the webhook and Telegram bodies.
js() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# post <url> <body> <content-type> ["Header: value"]...
post() {
	local url="$1" data="$2" type="$3" h n
	shift 3

	n=$#
	if command -v curl >/dev/null 2>&1; then
		for h in "Content-Type: $type" "$@"; do set -- "$@" -H "$h"; done
		shift "$n"
		curl -fsS -m 15 -X POST "$@" --data-binary "$data" "$url" >/dev/null 2>"$ERR.tmp"
	else
		for h in "Content-Type: $type" "$@"; do set -- "$@" "--header=$h"; done
		shift "$n"
		wget -q -T 15 -O /dev/null "$@" --post-data="$data" "$url" 2>"$ERR.tmp"
	fi
}

service=$(uci -q get $CFG.service)
rc=1
case "$service" in
ntfy)
	url=$(uci -q get $CFG.ntfy_url)
	token=$(uci -q get $CFG.ntfy_token)
	[ -n "$url" ] || { echo "no ntfy topic URL" > "$ERR"; [ "$event" = test ] && cat "$ERR"; exit 1; }
	if [ -n "$token" ]; then
		post "$url" "$text" text/plain "Title: $title" "Tags: telephone_receiver" "Authorization: Bearer $token"
	else
		post "$url" "$text" text/plain "Title: $title" "Tags: telephone_receiver"
	fi
	rc=$?
	;;
telegram)
	token=$(uci -q get $CFG.telegram_token)
	chat=$(uci -q get $CFG.telegram_chat)
	[ -n "$token" ] && [ -n "$chat" ] || { echo "no Telegram bot token or chat id" > "$ERR"; [ "$event" = test ] && cat "$ERR"; exit 1; }
	post "https://api.telegram.org/bot$token/sendMessage" \
		"{\"chat_id\":\"$(js "$chat")\",\"text\":\"$(js "$title: $text")\"}" application/json
	rc=$?
	;;
webhook)
	url=$(uci -q get $CFG.webhook_url)
	[ -n "$url" ] || { echo "no webhook URL" > "$ERR"; [ "$event" = test ] && cat "$ERR"; exit 1; }
	post "$url" "{\"event\":\"$(js "$event")\",\"number\":\"$(js "$number")\",\"name\":\"$(js "$name")\",\"title\":\"$(js "$title")\",\"text\":\"$(js "$text")\",\"host\":\"$(js "$host")\",\"time\":$(date +%s)}" application/json
	rc=$?
	;;
*)
	echo "unknown service '$service'" > "$ERR"
	;;
esac

if [ "$rc" = 0 ]; then
	rm -f "$ERR" "$ERR.tmp"
	[ "$event" = test ] && echo ok
	exit 0
fi
{ head -c 300 "$ERR.tmp" 2>/dev/null; } > "$ERR"
[ -s "$ERR" ] || echo "the $service server did not accept the message" > "$ERR"
rm -f "$ERR.tmp"
[ "$event" = test ] && cat "$ERR"
exit 1
