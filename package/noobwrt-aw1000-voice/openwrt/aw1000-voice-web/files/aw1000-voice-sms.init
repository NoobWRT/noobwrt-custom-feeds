#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# Watches the modem for new SMS (ModemManager) and hands each one to the
# alerts and, as a chat message, to the SIP phones (msipd).

START=99
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get aw1000_voice.sms.enabled)" = 0 ] && return 0
	command -v mmcli >/dev/null 2>&1 || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/aw1000-voice-sms watch
	procd_set_param respawn 3600 10 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger aw1000_voice
}
