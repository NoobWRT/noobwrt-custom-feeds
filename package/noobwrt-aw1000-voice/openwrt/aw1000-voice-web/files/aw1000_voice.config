config web 'web'
	# The management interface. After changing these, run
	# /usr/libexec/aw1000-voice-web-setup; the LuCI button follows the port.
	option port '7766'
	# lan: answer only on the LAN address. all: every address.
	option listen 'lan'

config notify 'notify'
	# Push alerts for call events, sent by /usr/libexec/aw1000-voice-notify
	# from fxsd's /etc/fxs/hook.sh. Set from the Alerts page.
	option enabled '0'
	# ntfy, telegram or webhook
	option service 'ntfy'
	list events 'missed'
	option ntfy_url ''
	option ntfy_token ''
	option telegram_token ''
	option telegram_chat ''
	option webhook_url ''
