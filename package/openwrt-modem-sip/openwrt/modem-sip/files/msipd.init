START=96
USE_PROCD=1

start_service() {
	local ip

	. /lib/functions/network.sh
	network_get_ipaddr ip lan
	procd_open_instance
	procd_set_param command /usr/sbin/msipd ${ip:+-b "$ip"}
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
