sec=
for s in $(uci -q show modem_sip | sed -n 's/^modem_sip\.\([^.=]*\)=phone$/\1/p'); do
	[ -z "$1" ] || [ "$(uci -q get "modem_sip.$s.name")" = "$1" ] || continue
	sec=$s
	break
done
[ -n "$sec" ] || exit 1
ip=$(uci -q get network.lan.ipaddr | awk '{ print $1 }')
port=$(uci -q get modem_sip.main.port)
echo "host=${ip%%/*}"
echo "port=${port:-5060}"
echo "user=$(uci -q get "modem_sip.$sec.user")"
echo "password=$(uci -q get "modem_sip.$sec.password")"
echo "transport=udp"
